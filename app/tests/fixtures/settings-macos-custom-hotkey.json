  },
  "macros": [],
  "restore_english_words": false,
  "open_settings_at_launch": true,
  "language": "System",
  "quick_telex": false,
  "telex_brackets": false,
  "strict_spell_check": false,
  "always_macro": false,
  "welcome_shown": false,
  "word_overrides": []
}